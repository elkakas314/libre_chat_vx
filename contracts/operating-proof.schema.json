{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operating-proof.schema.json",
  "type": "object",
  "required": [
    "proofId",
    "subject",
    "proofClass",
    "state",
    "dependencyFingerprint",
    "dependencies",
    "evidenceRefs"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "VALID",
        "STALE",
        "MISSING",
        "UNAVAILABLE"
      ]
    },
    "verified_at_source_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proofId": {
      "type": "string",
      "minLength": 1
    },
    "proofClass": {
      "enum": [
        "SOURCE_READBACK",
        "TEST",
        "DRIVE_READBACK",
        "RUNTIME_READBACK",
        "MATERIAL"
      ]
    },
    "dependencyFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history_classification": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
