{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operating-gap.schema.json",
  "type": "object",
  "required": [
    "gapId",
    "summary",
    "state",
    "priority",
    "scope",
    "requiresLive",
    "dependencies"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PASS",
        "OPEN",
        "STALE_PROOF",
        "OWNED",
        "WAITING_INTERNAL",
        "RECONCILE_REQUIRED",
        "GATE_EXTERNAL",
        "GATE_HUMAN",
        "BLOCKED_DEPENDENCY",
        "NOT_TESTED"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gapId": {
      "type": "string",
      "minLength": 1
    },
    "requiresLive": {
      "type": "boolean"
    },
    "preferredRoute": {
      "type": "string"
    },
    "ownerRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
