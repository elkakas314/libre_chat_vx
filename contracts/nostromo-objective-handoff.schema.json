{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nostromo-objective-handoff.schema.json",
  "title": "NOSTROMO authenticated objective handoff v1 — data validation, not authorization",
  "description": "SOURCE contract only. Validation of this JSON does not authenticate the user, grant privileges or execute the task. Authenticated host binds refs and verifies agreement; each target enforces its own authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective_ref",
    "conversation_ref",
    "agreement_ref",
    "plan_hash",
    "plan_version",
    "execution_lane",
    "target_id",
    "objective",
    "expected_result",
    "acceptance_criteria",
    "capability_refs",
    "context_refs",
    "constraints",
    "risk",
    "idempotency_key",
    "readback_required",
    "status",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "nostromo.objective.handoff.v1"
    },
    "objective_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "conversation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agreement_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Authenticated host record; never model-issued grant."
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "execution_lane": {
      "enum": [
        "NOSTROMO_LOCAL",
        "EXTERNAL_TARGET"
      ]
    },
    "target_id": {
      "enum": [
        "NOSTROMO_LOCAL",
        "MANOJOS3",
        "VX13"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expected_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "predicate_ref"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "predicate_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "capability_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "context_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "description": "References only; never raw history, secrets or long document bodies."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_paid_fallback",
        "max_execution_seconds"
      ],
      "properties": {
        "no_paid_fallback": {
          "const": true
        },
        "max_execution_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "forbidden_effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "readback_required": {
      "const": true
    },
    "status": {
      "enum": [
        "AGREED",
        "RESOLVING",
        "RESOLVED",
        "PREFLIGHT",
        "WAITING_AUTHORITY",
        "DISPATCHING",
        "EXECUTED_PENDING_READBACK",
        "UNKNOWN_OUTCOME",
        "VERIFIED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "authority": {
      "const": false,
      "description": "Handoff is a request, never an authority grant."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_lane": {
            "const": "NOSTROMO_LOCAL"
          }
        },
        "required": [
          "execution_lane"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "const": "NOSTROMO_LOCAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_lane": {
            "const": "EXTERNAL_TARGET"
          }
        },
        "required": [
          "execution_lane"
        ]
      },
      "then": {
        "properties": {
          "target_id": {
            "enum": [
              "MANOJOS3",
              "VX13"
            ]
          }
        }
      }
    }
  ]
}
