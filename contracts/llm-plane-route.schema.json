{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-plane-route.schema.json",
  "type": "object",
  "required": [
    "model_path",
    "action_path",
    "paid_fallback_allowed",
    "authority"
  ],
  "properties": {
    "model_path": {
      "enum": [
        "DIRECT_PROVIDER",
        "LOCAL_OPENAI_COMPATIBLE",
        "EXTERNAL_OPENAI_COMPATIBLE_ROUTER",
        "MANOJOS3_MANAGED_LITELLM"
      ]
    },
    "action_path": {
      "enum": [
        "NONE",
        "MANOJOS3_MCP"
      ]
    },
    "advisory_path": {
      "enum": [
        "NONE",
        "MANOJOS3_INTERFLOW_ADVISORY"
      ]
    },
    "model_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_endpoint_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "action_endpoint_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "zero_cost_verified": {
      "type": "boolean"
    },
    "paid_fallback_allowed": {
      "const": false
    },
    "authority": {
      "const": false
    }
  },
  "additionalProperties": false
}
