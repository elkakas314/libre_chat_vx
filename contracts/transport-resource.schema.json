{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "libre-chat-vx.transport-resource.schema.json",
  "type": "object",
  "required": [
    "id",
    "kind",
    "owner",
    "purpose",
    "sourceStatus",
    "runtimeStatus",
    "runtimeEvidenceRefs",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "LOCAL_WEB",
        "TAILSCALE_SERVE",
        "TAILSCALE_SERVICE",
        "TAILSCALE_SSH",
        "CLOUDFLARE_TUNNEL",
        "CLOUDFLARE_ACCESS_APP",
        "CLOUDFLARE_AI_GATEWAY",
        "CLOUDFLARE_WORKER",
        "GITHUB_SKILL_SYNC",
        "LIBRECHAT_AGENT_EVENTS",
        "EXTERNAL_PROJECT_CUTOVER"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "authority": {
      "const": false
    },
    "rollback": {
      "type": "string"
    },
    "sourceStatus": {
      "enum": [
        "SOURCE_DEFINED",
        "DECLARED_NOT_DEPLOYED",
        "DECLARED_LIVE_UNVERIFIED"
      ]
    },
    "runtimeStatus": {
      "enum": [
        "NO_DEPLOYMENT_EVIDENCE",
        "NOT_DEPLOYED",
        "DEPLOYED_UNVERIFIED",
        "LIVE_VERIFIED",
        "MATERIAL_VERIFIED"
      ]
    },
    "runtimeEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtimeObservedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "runtimeStatus": {
            "enum": [
              "NOT_DEPLOYED",
              "DEPLOYED_UNVERIFIED",
              "LIVE_VERIFIED",
              "MATERIAL_VERIFIED"
            ]
          }
        },
        "required": [
          "runtimeStatus"
        ]
      },
      "then": {
        "required": [
          "runtimeObservedAt"
        ],
        "properties": {
          "runtimeEvidenceRefs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
