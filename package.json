{
  "name": "@librechat/vx",
  "version": "0.1.0",
  "private": true,
  "description": "Governed LibreChat cockpit and target projection layer.",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "contracts",
    "config",
    "overlay"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run transport:validate && npm run build && node --test dist/tests/*.test.js && npm run nostromo:check:test && npm run nostromo:workspace:test && npm run nostromo:local:audit:test",
    "check": "npm run test",
    "verify:upstream": "node scripts/verify-upstream.mjs ../upstream",
    "overlay:install": "node scripts/install-as-workspace.mjs ../upstream",
    "overlay:uninstall": "node scripts/uninstall-overlay.mjs ../upstream",
    "transport:validate": "node scripts/validate-parallel-transport.mjs",
    "nostromo:check": "node scripts/nostromo-preflight.mjs",
    "nostromo:check:test": "node --test scripts/tests/nostromo-preflight.test.mjs",
    "nostromo:workspace:preview": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream",
    "nostromo:workspace:apply": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream --apply",
    "nostromo:workspace:test": "node --test scripts/tests/reconcile-existing-workspace.test.mjs scripts/tests/stage-react-types.test.mjs scripts/tests/workspace-noop-gate.test.mjs",
    "nostromo:workspace:diagnose": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream --diagnose",
    "nostromo:frontend:deps:inspect": "node scripts/inspect-librechat-frontend-deps.mjs --upstream=../upstream",
    "nostromo:frontend:deps:test": "node --test scripts/tests/inspect-librechat-frontend-deps.test.mjs",
    "nostromo:local:audit": "node scripts/audit-local-librechat.mjs",
    "nostromo:local:audit:test": "node --test scripts/tests/audit-local-librechat.test.mjs",
    "nostromo:visual:preview": "node scripts/reconcile-native-visual.mjs",
    "nostromo:visual:apply": "node scripts/reconcile-native-visual.mjs --apply",
    "nostromo:visual:test": "node --test scripts/tests/reconcile-native-visual.test.mjs",
    "nostromo:frontend:deps:repair": "node scripts/repair-librechat-frontend-deps.mjs",
    "nostromo:frontend:deps:repair:test": "node --test scripts/tests/repair-librechat-frontend-deps.test.mjs scripts/tests/librechat-npm-dry-run-guard.test.mjs scripts/tests/librechat-frontend-npm-gate.test.mjs scripts/tests/stage-isolated-npm11.test.mjs",
    "nostromo:runtime:npm11:preview": "node scripts/stage-isolated-npm11.mjs",
    "nostromo:runtime:npm11:stage": "node scripts/stage-isolated-npm11.mjs --apply",
    "nostromo:runtime:npm11:test": "node --test scripts/tests/stage-isolated-npm11.test.mjs",
    "nostromo:wiring:inspect": "node scripts/audit-nostromo-native-wiring.mjs",
    "nostromo:wiring:test": "node --test scripts/tests/audit-nostromo-native-wiring.test.mjs scripts/tests/nostromo-initial-yaml.test.mjs",
    "nostromo:wiring:config:preview": "node scripts/stage-nostromo-mcp-config.mjs",
    "nostromo:wiring:config:stage": "node scripts/stage-nostromo-mcp-config.mjs --apply",
    "nostromo:backups:audit": "python3 -B scripts/nostromo-backup-audit-r0.py",
    "nostromo:backups:test": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s scripts/tests -p 'test_nostromo_backup_audit_r0.py' -v && node --test scripts/tests/workspace-noop-gate.test.mjs && node --test scripts/tests/legacy-guard.test.mjs",
    "nostromo:layout:test": "node --test scripts/tests/nostromo-layout.test.mjs",
    "nostromo:mobile:preflight": "node scripts/audit-nostromo-mobile-readiness.mjs",
    "nostromo:mobile:preflight:test": "node --test scripts/tests/nostromo-mobile-readiness.test.mjs",
    "nostromo:backend:preflight": "node scripts/nostromo-backend-preflight.mjs",
    "nostromo:backend:preflight:test": "node --test scripts/tests/nostromo-backend-preflight.test.mjs",
    "nostromo:layout:migrate:preview": "node scripts/nostromo-layout-relocate.mjs",
    "nostromo:layout:migrate:test": "node --test scripts/tests/nostromo-layout-relocate.test.mjs",
    "nostromo:qa:diagnostics": "npm run nostromo:runtime:npm11:test && npm run nostromo:frontend:deps:repair:test && npm run nostromo:visual:test && npm run nostromo:workspace:test && npm run nostromo:wiring:test && npm run nostromo:backups:test && npm run nostromo:local:audit:test && npm run nostromo:layout:test && npm run nostromo:layout:migrate:test && npm run nostromo:mobile:preflight:test && npm run nostromo:backend:preflight:test && npm run nostromo:third-upstream:test && npm run nostromo:third-upstream:extract:test",
    "nostromo:third-upstream:audit": "PYTHONDONTWRITEBYTECODE=1 python3 -B scripts/audit-nostromo-third-upstream-r0.py",
    "nostromo:third-upstream:test": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s scripts/tests -p 'test_nostromo_third_upstream_r0.py' -v",
    "nostromo:third-upstream:extract": "PYTHONDONTWRITEBYTECODE=1 python3 -B scripts/extract-third-upstream-differences-r0.py",
    "nostromo:third-upstream:extract:test": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s scripts/tests -p 'test_nostromo_third_upstream_extract_r0.py' -v"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
