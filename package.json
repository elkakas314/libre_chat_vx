{
  "name": "@librechat/vx",
  "version": "0.1.0",
  "private": true,
  "description": "Governed LibreChat cockpit and target projection layer.",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "contracts",
    "config",
    "overlay"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run transport:validate && npm run build && node --test dist/tests/*.test.js && npm run nostromo:check:test && npm run nostromo:workspace:test",
    "check": "npm run test",
    "verify:upstream": "node scripts/verify-upstream.mjs ../upstream",
    "overlay:install": "node scripts/install-as-workspace.mjs ../upstream",
    "overlay:uninstall": "node scripts/uninstall-overlay.mjs ../upstream",
    "transport:validate": "node scripts/validate-parallel-transport.mjs",
    "nostromo:check": "node scripts/nostromo-preflight.mjs",
    "nostromo:check:test": "node --test scripts/tests/nostromo-preflight.test.mjs",
    "nostromo:workspace:preview": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream",
    "nostromo:workspace:apply": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream --apply",
    "nostromo:workspace:test": "node --test scripts/tests/reconcile-existing-workspace.test.mjs scripts/tests/stage-react-types.test.mjs",
    "nostromo:workspace:diagnose": "node scripts/reconcile-existing-workspace.mjs --upstream=../upstream --diagnose",
    "nostromo:frontend:deps:inspect": "node scripts/inspect-librechat-frontend-deps.mjs --upstream=../upstream",
    "nostromo:frontend:deps:test": "node --test scripts/tests/inspect-librechat-frontend-deps.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
