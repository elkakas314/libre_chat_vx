{
  "schema": "libre-chat-vx.parallel-transport.v2",
  "status": "SOURCE_CANON_COMPLETE_LIVE_NOT_DEPLOYED",
  "authority": false,
  "purpose": "Dedicated LibreChat VX access/inference/event transport architecture, isolated from MANOJOS3 until an explicit future cutover.",
  "canonical_counts": {
    "cloudflare_ai_gateways": 1,
    "dynamic_routes": 7,
    "cloudflare_tunnels_required": 0,
    "cloudflare_tunnels_optional_public_web": 1,
    "cloudflare_workers_required": 0,
    "cloudflare_workers_optional_max_without_architecture_review": 1,
    "tailscale_serve_private_routes": 1,
    "tailscale_services_required": 0,
    "tailscale_funnel": 0,
    "openai_secure_mcp_tunnels_for_librechat": 0
  },
  "invariants": {
    "reuse_manojos3_tunnels": false,
    "reuse_manojos3_workers": false,
    "reuse_manojos3_hostnames": false,
    "reuse_manojos3_ports": false,
    "modify_manojos3": false,
    "public_access_requires_identity_gate": true,
    "ai_gateway_is_not_tunnel": true,
    "transport_is_not_authority": true,
    "no_public_admin_endpoint": true,
    "no_material_retry_on_reconnect": true
  },
  "reserved_manojos3": {
    "ports": [
      8787,
      8790,
      8791,
      4000,
      8931,
      9223
    ],
    "resource_name_fragments": [
      "manojos3",
      "manojos2-action-proxy",
      "host-control"
    ],
    "note": "Isolation guard only. LibreChat VX must not read, modify, proxy or reuse these MANOJOS3 resources during parallel validation."
  },
  "librechat_service": {
    "bind_host": "127.0.0.1",
    "port": 3080,
    "owner": "LIBRECHAT_VX",
    "deployment_shape": "SINGLE_INSTANCE_BASELINE",
    "resumable_streams": "NATIVE_IN_MEMORY_BASELINE"
  },
  "private_remote": {
    "kind": "TAILSCALE_SERVE",
    "baseline": true,
    "public_internet": false,
    "target": "http://127.0.0.1:3080",
    "funnel": false,
    "acl_required": true,
    "resource_alias": "librechat-vx-private",
    "services_upgrade": "OPTIONAL_WHEN_MULTI_HOST_OR_HA"
  },
  "public_remote_optional": {
    "kind": "CLOUDFLARE_TUNNEL_ACCESS",
    "baseline": false,
    "tunnel_count": 1,
    "tunnel_name": "librechat-vx-web",
    "origin": "http://127.0.0.1:3080",
    "access_required": true,
    "browser_hostname_env": "LIBRECHAT_VX_PUBLIC_HOSTNAME",
    "events_hostname_env": "LIBRECHAT_VX_EVENTS_HOSTNAME",
    "machine_api_extra_gate": "ACCESS_SERVICE_TOKEN_OR_EQUIVALENT_IF_PUBLIC",
    "credentials_persisted_in_repo": false
  },
  "inference": {
    "kind": "CLOUDFLARE_AI_GATEWAY",
    "gateway_count": 1,
    "gateway_resource_hint": "librechat-vx-nostromo",
    "semantic_routes": [
      "dynamic/nostromo-rapido",
      "dynamic/nostromo-normal",
      "dynamic/nostromo-pensar",
      "dynamic/nostromo-investigar",
      "dynamic/nostromo-visualizar",
      "dynamic/nostromo-contexto-largo",
      "dynamic/nostromo-vision"
    ],
    "provider_bootstrap": [
      "CLOUDFLARE_WORKERS_AI",
      "GROQ",
      "GOOGLE_AI_STUDIO_GEMINI"
    ],
    "provider_reserve": [
      "MISTRAL",
      "OPENROUTER_FREE"
    ],
    "exact_models": "DISCOVER_AND_ADMIT_LIVE",
    "paid_fallback_allowed": false,
    "traverses_cloudflare_tunnel": false
  },
  "workers": {
    "required": [],
    "optional": [
      {
        "id": "librechat-vx-event-normalizer",
        "status": "NOT_PROVISIONED",
        "create_only_if": "AN_EXTERNAL_EVENT_SOURCE_CANNOT_SEND_LIBRECHAT_AGENT_EVENTS_DIRECTLY",
        "purpose": "Validate and normalize a narrow webhook payload into the Agent Events shape.",
        "forbidden": [
          "CLOUDFLARE_ACCOUNT_ADMIN_TOKEN",
          "AI_GATEWAY_ADMINISTRATION",
          "TARGET_MATERIAL_EXECUTION",
          "REPO_WRITE",
          "AUTHORIZATION_MINTING"
        ],
        "fail_mode": "FAIL_CLOSED"
      }
    ]
  },
  "application_routes": {
    "agent_events": "/api/agents/v1/events",
    "skill_sync": "OUTBOUND_HTTPS_GITHUB",
    "target_gateway": "IN_PROCESS_NO_PUBLIC_HTTP_ROUTER"
  },
  "recovery": {
    "host_service": "FUTURE_LIVE_BINDING",
    "tailscale_ssh": "PLANNED_OUT_OF_BAND",
    "librechat_self_recovery_only": false
  },
  "manojos3_transport_convergence": {
    "status": "DEFERRED_DO_NOT_TOUCH_NOW",
    "blocks_librechat": false
  },
  "live": "NO_VERIFICADO"
}
