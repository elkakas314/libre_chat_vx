{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-capability-projection.schema.json",
  "type": "object",
  "required": ["target_id", "capability_id", "risk", "effect_class", "availability", "authority_owner", "source_revision", "observed_at"],
  "properties": {
    "target_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string"},
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "effect_class": {"enum": ["READ_ONLY", "EPHEMERAL", "MATERIAL", "DESTRUCTIVE"]},
    "availability": {"type": "string"},
    "authority_owner": {"type": "string"},
    "required_scopes": {"type": "array", "items": {"type": "string"}},
    "source_revision": {"type": "string"},
    "observed_at": {"type": "string"},
    "expires_at": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
